# Triagewall configuration
# Copy this file to .env and edit for your environment.

# === LLM backend ===
# Ollama instance running the triage model
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# === Alert source ===
# Path to Suricata's eve.json (the daemon tails this file)
EVE_PATH=/var/log/suricata/eve.json

# Position tracking — daemon stores its read offset here
POSITION_PATH=/var/lib/triagewall/position.json

# How often to poll eve.json for new content (seconds)
POLL_INTERVAL=10

# Demo mode (no Suricata feed required): replays JSON-lines fixtures in a loop
DEMO_MODE=false

# === Database ===
# SQLite database path
DB_PATH=/var/lib/triagewall/triage.db

# === Dashboard ===
DASHBOARD_PORT=8084
DASHBOARD_HOST=0.0.0.0

# Dashboard mode: local (full data + feedback) or demo (masked IPs + read-only)
MODE=local

# === Logging ===
LOG_LEVEL=INFO

# Timezone for containers / logs (optional)
TZ=UTC

# === Docker compose convenience (host paths) ===
# Bind-mount local persistence directory into containers (maps to /var/lib/triagewall by default)
HOST_DATA_DIR=./data

# Bind-mount a host eve.json file into the ingest container (maps to EVE_PATH inside the container)
HOST_EVE_PATH=./data/eve.json

# === Optional: Wazuh integration ===
# Uncomment and configure to pull alerts from a Wazuh manager
# WAZUH_API_URL=https://wazuh.example.com:55000
# WAZUH_API_USER=triagewall
# WAZUH_API_PASSWORD=...
