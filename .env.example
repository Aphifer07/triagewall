# Triagewall configuration
# Copy this file to .env and edit for your environment.

# === LLM backend ===
# Ollama instance running the triage model
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# === Alert source ===
# Path to Suricata's eve.json (the daemon tails this file)
EVE_PATH=/var/log/suricata/eve.json

# Position tracking — daemon stores its read offset here
POSITION_PATH=/var/lib/triagewall/position.json

# How often to poll eve.json for new content (seconds)
POLL_INTERVAL=10

# === Database ===
# SQLite database path
DB_PATH=/var/lib/triagewall/triage.db

# === Dashboard ===
DASHBOARD_PORT=8084
DASHBOARD_HOST=0.0.0.0

# === Logging ===
LOG_LEVEL=INFO

# === Optional: Wazuh integration ===
# Uncomment and configure to pull alerts from a Wazuh manager
# WAZUH_API_URL=https://wazuh.example.com:55000
# WAZUH_API_USER=triagewall
# WAZUH_API_PASSWORD=...
